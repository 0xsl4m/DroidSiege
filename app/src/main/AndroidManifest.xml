<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- intentional: see M5/M7 challenges -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DroidSiegeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidSiege"
        android:backupAgent=".challenges.storage.SiegeBackupAgent"
        android:usesCleartextTraffic="true">
        <!-- intentional: usesCleartextTraffic above is the M5/M7 cleartext seed;
             allowBackup + dataExtractionRules + backupAgent are the M9 backup
             family seeds, and the agent/rules deliberately include app data. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- intentional: broad file_paths.xml is the M9 extstorage L3 seed -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.transfer"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
